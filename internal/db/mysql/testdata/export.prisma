generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum posts_status {
  todo
  in_progress @map("in progress")
  done
}

/// The table has no primary key or unique column, so Prisma Client cannot use it.
model audit_log {
  at  DateTime? @db.DateTime(0)
  msg String?   @db.Text

  @@ignore
}

model categories {
  id                Int          @id @default(autoincrement())
  parent_id         Int?
  slug              String       @db.VarChar(40)
  parent            categories?  @relation("categories_parent", fields: [parent_id], references: [id])
  categories_parent categories[] @relation("categories_parent")

  @@unique([parent_id, slug])
}

model invites {
  id    Int     @id @default(autoincrement())
  email String? @db.VarChar(255)
  users users?  @relation(fields: [email], references: [email])
}

model offices {
  id      Int     @id
  country String  @db.Char(2)
  code    String  @db.VarChar(10)
  regions regions @relation(fields: [country, code], references: [country, code])
}

model order_items {
  id         Int    @id @default(autoincrement())
  unit_price Float? @map("unit price") @db.Float
  qty        Int

  @@map("order items")
}

model post_tags {
  post_id  BigInt
  tag_code String @db.VarChar(20)
  post     posts  @relation(fields: [post_id], references: [id])
  tags     tags   @relation(fields: [tag_code], references: [code])

  @@id([post_id, tag_code])
}

model posts {
  id           BigInt       @id @default(autoincrement())
  author_id    Int
  editor_id    Int?
  title        String       @default("it's \"new\"") @db.VarChar(200)
  status       posts_status @default(todo)
  body         Bytes?       @db.Blob
  score        Decimal?     @default(1.50) @db.Decimal(10, 2)
  ratio        Float?       @db.Float
  published_on DateTime?    @db.Date
  author       users        @relation("posts_author", fields: [author_id], references: [id])
  editor       users?       @relation("posts_editor", fields: [editor_id], references: [id])
  post_tags    post_tags[]
}

model regions {
  country String    @db.Char(2)
  code    String    @db.VarChar(10)
  offices offices[]

  @@id([country, code])
}

model tags {
  code      String      @id @db.VarChar(20)
  label     String?     @db.Text
  post_tags post_tags[]
}

model users {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  name         String?   @db.Text
  created_at   DateTime  @default(now()) @db.DateTime(3)
  joined       DateTime? @default(now()) @db.Timestamp(0)
  active       Boolean   @default(true)
  settings     Json?
  uid          String    @default(dbgenerated("(uuid())")) @db.VarChar(36)
  visits       Int       @default(0) @db.UnsignedInt
  invites      invites[]
  posts_author posts[]   @relation("posts_author")
  posts_editor posts[]   @relation("posts_editor")
}
