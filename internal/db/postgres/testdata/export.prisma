generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum task_status {
  todo
  in_progress @map("in progress")
  done
}

/// The table has no primary key or unique column, so Prisma Client cannot use it.
model audit_log {
  at  DateTime? @db.Timestamp(6)
  msg String?

  @@ignore
}

model categories {
  id                Int          @id @default(autoincrement())
  parent_id         Int?
  slug              String       @db.VarChar(40)
  parent            categories?  @relation("categories_parent", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories_parent categories[] @relation("categories_parent")

  @@unique([parent_id, slug])
}

model invites {
  id    Int     @id @default(autoincrement())
  email String? @db.VarChar(255)
  users users?  @relation(fields: [email], references: [email], onUpdate: NoAction)
}

model offices {
  id      Int     @id
  country String  @db.Char(2)
  code    String  @db.VarChar(10)
  regions regions @relation(fields: [country, code], references: [country, code], onDelete: Cascade)
}

model order_items {
  id         Int     @id @default(autoincrement())
  unit_price Float?  @map("unit price") @db.Real
  qty        Int
  note       String? @db.VarChar(20)

  @@map("order items")
}

model post_tags {
  post_id  BigInt
  tag_code String @db.VarChar(20)
  post     posts  @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags     tags   @relation(fields: [tag_code], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@id([post_id, tag_code])
}

model posts {
  id           BigInt                   @id @default(autoincrement())
  author_id    Int
  editor_id    Int?
  title        String                   @default("it's \"new\"") @db.VarChar(200)
  status       task_status              @default(todo)
  body         Bytes?
  score        Decimal?                 @default(1.50) @db.Decimal(10, 2)
  ratio        Float?                   @db.Real
  published_on DateTime?                @db.Date
  span         Unsupported("interval")?
  author       users                    @relation("posts_author", fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  editor       users?                   @relation("posts_editor", fields: [editor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  post_tags    post_tags[]

  @@index([author_id, published_on], map: "by_author")
  @@index([title])
}

model regions {
  country String    @db.Char(2)
  code    String    @db.VarChar(10)
  offices offices[]

  @@id([country, code])
}

model tags {
  code      String      @id @db.VarChar(20)
  label     String?
  post_tags post_tags[]
}

model users {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  name         String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  joined       DateTime? @default(now()) @db.Timestamp(3)
  active       Boolean   @default(true)
  settings     Json?     @default(dbgenerated("'{}'::jsonb"))
  uid          String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visits       Int       @default(-1) @db.SmallInt
  invites      invites[]
  posts_author posts[]   @relation("posts_author")
  posts_editor posts[]   @relation("posts_editor")
}
